# ==============================================================================
# MEDGUARD EHR - ROOT ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env or pass as container environment variables during deployment.
# ==============================================================================

# Backend Port & Runtime Environment
PORT=5000
NODE_ENV=development

# Web Frontend URL & CORS Whitelist
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# PostgreSQL Database Connection String
# Example: postgresql://postgres:your_password@localhost:5432/medguard
DATABASE_URL=

# Field-Level Envelope Encryption (AES-256-GCM)
# MASTER_ENCRYPTION_KEY must be a 64-character hexadecimal string (32 bytes)
MASTER_ENCRYPTION_KEY=
# Blind index HMAC secret for encrypted patient search indexing
IDENTIFIER_HMAC_SECRET=

# External Policy & Risk Microservice Endpoints
RISK_ENGINE_URL=http://127.0.0.1:8000
OPA_URL=http://127.0.0.1:8181/v1/data/medguard/access

# EVM Node RPC & Signer Key (Optional / Private Hospital Subnet)
ETH_RPC_URL=http://127.0.0.1:8545
ETH_SIGNER_PRIVATE_KEY=

# Smart Contract Addresses (Deployed on local hardhat or private EVM)
CONSENT_REGISTRY_ADDRESS=
ACCESS_AUDIT_LOG_ADDRESS=
BREAK_GLASS_REGISTRY_ADDRESS=

# Authentication, Session Cookies & Step-Up MFA
# Secrets must be >= 32 characters in production
JWT_SECRET=
MFA_CHALLENGE_SECRET=

# SMTP Email Dispatch for Dynamic 2FA OTPs
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="MedGuard Clinical Security" <security@hospital.lk>

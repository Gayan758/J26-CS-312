PORT=5000
NODE_ENV=development

# Frontend & CORS Whitelist Configuration
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database Configuration (PostgreSQL)
# Format: postgresql://user:password@localhost:5432/medguard
DATABASE_URL=

# Field-Level Envelope Encryption & Blind Index Secrets (OWASP ASVS Level 2)
# MASTER_ENCRYPTION_KEY must be a 64-character hex string (32 bytes AES-256)
MASTER_ENCRYPTION_KEY=
# IDENTIFIER_HMAC_SECRET used to hash patient identifiers (NIC) for search indexing
IDENTIFIER_HMAC_SECRET=

# Python RiskBAC Engine URL
RISK_ENGINE_URL=http://127.0.0.1:8000

# OPA Policy Engine URL
OPA_URL=http://127.0.0.1:8181/v1/data/medguard/access

# Ethereum / EVM Audit RPC & Signer Key
ETH_RPC_URL=http://127.0.0.1:8545
ETH_SIGNER_PRIVATE_KEY=

# Deployed Contract Addresses
CONSENT_REGISTRY_ADDRESS=
ACCESS_AUDIT_LOG_ADDRESS=
BREAK_GLASS_REGISTRY_ADDRESS=

# Cryptographic Session & Step-Up MFA Secrets (Minimum 32 characters in production)
JWT_SECRET=
MFA_CHALLENGE_SECRET=

# SMTP Email Configuration for 2FA Step-up
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="MedGuard Security" <security@hospital.lk>

# Traccar GPS Telemetry Integration
TRACCAR_API_URL=http://127.0.0.1:8082
TRACCAR_USER=admin
TRACCAR_PASS=admin
